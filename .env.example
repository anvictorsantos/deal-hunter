# Neon Postgres (pooled for the app, direct for migrations/db push)
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"
RAWG_API_KEY="your-rawg-key"
CRON_SECRET="long-random-string"
# OLX scraping needs no credentials — API creds removed (see ADR 0004)
# OLX partner credentials power the "Near me" filter (ADR 0006)
OLX_CLIENT_ID=""
OLX_CLIENT_SECRET=""
